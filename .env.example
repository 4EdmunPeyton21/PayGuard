# LLM configuration
LLM_PROVIDER=nvidia
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-xxx
LLM_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_S=45
LLM_CACHE=true
USE_BEDROCK_NATIVE=false

# Agent configuration
AGENT_RUNTIME=strands
MAX_TOOL_CALLS=6
ENABLE_GAP_CHECKER=true
NARRATOR_MAX_RETRIES=1

# Risk policy & Knowledge Base
RISK_POLICY=risk_policy_v1
KB_DIR=./app/kb

# AWS / Local storage
AWS_REGION=us-west-2
DDB_TABLE=PayGuardCases
DDB_ENDPOINT_URL=http://localhost:8000
S3_BUCKET=payguard-uploads
S3_ENDPOINT_URL=http://localhost:4566

# Data lifecycle & privacy
CASE_TTL_DAYS=7
RAW_TEXT_TTL_HOURS=24
STORE_RAW_INPUT=false

# Ingest & Security limits
ENABLE_REDIRECT_RESOLUTION=false
MAX_UPLOAD_MB=5
RATE_LIMIT_PER_MIN=20
